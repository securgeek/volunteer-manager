# Copy to .env and fill in. `docker compose up` reads it automatically.

# ── Postgres (scheduler) ──────────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme

# ── Shared secrets ────────────────────────────────────────────────────────────
# The email lookup key. BOTH services need the SAME value, and it is deliberately not
# stored in either database: portal.db holds the hashes it produces, so keeping the key
# there too would hand over both halves to anyone who copies the file.
#
#   openssl rand -hex 32
#
# Once volunteers exist, changing this orphans every stored email_hmac — nobody can sign
# in and duplicate detection stops working. The portal refuses to start without it rather
# than quietly generating a new one.
EMAIL_HMAC_KEY=

# Signs every scheduler -> portal request. Also the same on both sides.
#   openssl rand -hex 32
SYNC_KEY_ID=bsc-2026
SYNC_SECRET=
# Set during a rotation so the portal accepts the old secret until the scheduler restarts.
SYNC_SECRET_PREV=

# ── Where each service finds the other ────────────────────────────────────────
# Two different things, deliberately two different names.
#
# PORTAL_SYNC_URL  — where the SCHEDULER dials the portal's API. Usually internal.
# PORTAL_PUBLIC_URL — what volunteers see in a magic link. Must be browser-reachable.
#                     It is the SITE's origin, not the portal's: links land on the
#                     frontend at /apply/verify. Locally http://localhost:<FRONTEND_PORT>;
#                     deployed, the public hostname the tunnel sends to PORTAL_SITE_PORT.
# ADMIN_PUBLIC_URL  — the organizer site's origin: invite and reset links, and the passkey
#                     relying party (changing it orphans every passkey). Deployed, the
#                     gated admin hostname the tunnel sends to FRONTEND_PORT. Leave it
#                     unset when one origin serves both (local dev).
#
# Leave PORTAL_SYNC_URL empty to run the scheduler with no portal at all: the sync task
# never starts and nothing else changes.
PORTAL_SYNC_URL=http://portal:5001
PORTAL_PUBLIC_URL=http://localhost:8080
# ADMIN_PUBLIC_URL=
PORTAL_SYNC_INTERVAL=30
# Set to 0 only for a self-signed portal certificate in development.
PORTAL_SYNC_VERIFY_TLS=1

# ── Audit log ─────────────────────────────────────────────────────────────────
# Days the audit_events table (the admin site's Audit Log) keeps an event; 0 keeps them all.
# logs/audit.jsonl keeps everything regardless.
# AUDIT_RETENTION_DAYS=365

# ── Portal mail ───────────────────────────────────────────────────────────────
# file = write .eml into logs/portal_mail/ instead of sending. The whole flow is
# exercisable this way with no mail server.
# smtp  = send through SMTP_HOST.
# relay = hand plain text to the mailrelay container, which sends through Microsoft Graph as
#         MAIL_SENDER. Setup: docs/operations/graph-mail-setup.md.
MAIL_BACKEND=file
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=volunteers@example.org

# ── Mail relay (MAIL_BACKEND=relay) ───────────────────────────────────────────
# Shared by the portal and mailrelay; at least 32 characters. openssl rand -hex 32
MAIL_RELAY_TOKEN=
# Read by mailrelay only. The portal never sees these. No client secret: the relay signs in
# as RELAY_MAILBOX with delegated Mail.Send, once, via
#   podman-compose exec mailrelay python relay.py login
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
# The account that signs in, and the mailbox mail goes through. It needs Send As on
# MAIL_SENDER.
RELAY_MAILBOX=
# The From address of everything the relay and vol_mail send: the conference's volunteer
# address, often a Microsoft 365 group. Required by the relay. Set once per deployment, not in
# the app, because it's tied to the tenant's Send As permission. (The contact address the
# volunteer pages show is separate: Admin → App Settings.)
MAIL_SENDER=

# ── Frontend ──────────────────────────────────────────────────────────────────
# Host ports for the frontend, published on 127.0.0.1 only. nginx serves plain HTTP;
# the edge terminates TLS and a tunnel client on the host dials these (frontend/default.conf):
#   FRONTEND_PORT    → the full site (/admin and the organizer API), for ADMIN_PUBLIC_URL
#   PORTAL_SITE_PORT → the volunteer portal alone, for PORTAL_PUBLIC_URL
# Keep both above 1024: rootless can't bind privileged ports on the host.
# FRONTEND_PORT=8080
# PORTAL_SITE_PORT=8082

# Deploy target for `rsync -aF BSides/ "$DEPLOY_HOST:Scheduler/"` (.rsync-filter). Not read by
# any container; kept here so the address isn't in the repo.
DEPLOY_HOST=
